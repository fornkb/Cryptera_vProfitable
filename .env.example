# Copy to .env and fill in. Never commit the real .env.
# GEMINI_API_KEY is required; _2 and _3 are optional extra keys the engine
# round-robins across, failing over on error with a per-key cooldown.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_KEY_2=your_second_gemini_api_key
GEMINI_API_KEY_3=your_third_gemini_api_key

# ---- Telegram alerts (optional; required only for monitor.py) ----
# Use a bot/chat dedicated to this version so alerts are distinguishable from
# any other Cryptera deployment (e.g. v4.x) posting to your Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# WATCHLIST=SOL/USDT,BTC/USDT,ETH/USDT
# SCORE_THRESHOLD=60              # matches config.ACTIVE_TRADE_THRESHOLD by default
# CONDITIONAL_SCORE_THRESHOLD=45  # matches config.CONDITIONAL_ENTRY_THRESHOLD by default
# MATERIAL_DELTA=10               # score jump that re-narrates an active setup
# MIN_REALERT_SECONDS=7200        # per-symbol cooldown (2h); keep N*(86400/this) <= DAILY_BUDGET
# DAILY_BUDGET=40                 # usable 36 across 3 keys (12/key, <20/key)
# BUDGET_RESERVE=4
# MIN_CALL_SPACING=8
# ALERT_ON_CONDITIONAL=false
# POLL_SECOND_OFFSET=30
# CRYPTERA_NO_CHART_SERIES=1      # set on a headless corpus VM to shrink persisted snapshots
